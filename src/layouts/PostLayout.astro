---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/posts';
import { formatPostDate, getExcerpt, getPostUrl, slugify } from '../lib/posts';
import AuthorCard from '../components/AuthorCard.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const toc = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
const date = post.filePath?.match(/\d{4}-\d{2}-\d{2}/)?.[0];
---

<BaseLayout title={post.data.title} description={getExcerpt(post)} lang={post.data.locale ?? 'en'}>
  <div class="article-shell">
    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Journal entry</p>
        <h1>{post.data.title}</h1>
        <time datetime={date}>{formatPostDate(post, post.data.locale)}</time>
        <div class="taxonomy">
          {post.data.categories.map((category) => <a href={`/categories/${slugify(category)}/`}>{category}</a>)}
          {post.data.tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}
        </div>
      </header>

      {toc.length > 1 && (
        <details class="toc">
          <summary>On this page</summary>
          <ol>
            {toc.map((heading) => (
              <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose"><slot /></div>

      <nav class="post-nav" aria-label="Post navigation">
        {newer ? <a href={getPostUrl(newer)}><span>Newer</span>{newer.data.title}</a> : <span />}
        {older ? <a class="older" href={getPostUrl(older)}><span>Older</span>{older.data.title}</a> : <span />}
      </nav>
    </article>
    <AuthorCard />
  </div>
</BaseLayout>
